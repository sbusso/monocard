// What the empty Loupe and the empty Library show in the mono build:
// never in the way of a click.

import { Theme } from "../../greycard-slint/ui/theme.slint";

export component MonoSplash inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #777777;
    VerticalLayout {
        alignment: center;
        spacing: Theme.space-3;
        Image {
            source: @image-url("../../../assets/monocard/icon.svg");
            height: 96px;
            image-fit: contain;
        }
        Text {
            text: "Monocard";
            color: #000000;
            font-size: Theme.font-xl;
            font-weight: Theme.weight-medium;
            horizontal-alignment: center;
        }
        Text {
            text: "The darkroom for monochrome sensors.";
            color: #000000;
            font-size: Theme.font-md;
            horizontal-alignment: center;
        }
    }
}
