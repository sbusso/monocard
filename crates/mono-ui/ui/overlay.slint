// What the mono views put over the picture: the split's handle and the
// zone view's legend.

import { Theme } from "../../greycard-slint/ui/theme.slint";
import { Mono } from "state.slint";

export component MonoOverlay inherits Rectangle {
    callback focus-keys();
    if Mono.split == "Split": Rectangle {
        x: Mono.split-at * root.width - self.width / 2;
        width: 1px;
        height: 100%;
        background: Theme.text;
        drop-shadow-blur: 2px;
        drop-shadow-color: #000000;
    }
    if Mono.split == "Split": grip := Rectangle {
        x: Mono.split-at * root.width - self.width / 2;
        y: (root.height - self.height) / 2;
        width: 24px;
        height: 40px;
        border-radius: 12px;
        border-width: keys.has-focus ? 2px : 1px;
        border-color: keys.has-focus ? Theme.accent : Theme.text;
        background: area.pressed || area.has-hover ? Theme.hover : Theme.surface;
        accessible-role: slider;
        accessible-label: "Split between before and after";
        accessible-value: round(Mono.split-at * 100) + "%";
        accessible-value-minimum: 0;
        accessible-value-maximum: 100;
        accessible-value-step: 1;
        accessible-action-increment => { Mono.split-moved(Mono.split-at + 0.01); }
        accessible-action-decrement => { Mono.split-moved(Mono.split-at - 0.01); }
        Text {
            width: 100%;
            height: 100%;
            text: "\u{2194}";
            color: Theme.text;
            font-size: Theme.font-sm;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
        keys := FocusScope {
            changed has-focus => { Mono.split-keys = self.has-focus; }
            key-pressed(e) => {
                if (e.text == Key.LeftArrow || e.text == Key.DownArrow) {
                    Mono.split-moved(Mono.split-at - (e.modifiers.shift ? 0.1 : 0.01));
                    return accept;
                }
                if (e.text == Key.RightArrow || e.text == Key.UpArrow) {
                    Mono.split-moved(Mono.split-at + (e.modifiers.shift ? 0.1 : 0.01));
                    return accept;
                }
                if (e.text == Key.Home || e.text == Key.End) {
                    Mono.split-moved(e.text == Key.Home ? 0 : 1);
                    return accept;
                }
                if (e.text == Key.Escape) {
                    root.focus-keys();
                    return accept;
                }
                return reject;
            }
        }
        area := TouchArea {
            mouse-cursor: MouseCursor.ew-resize;
            moved => {
                if (self.pressed) {
                    Mono.split-moved((self.absolute-position.x + self.mouse-x
                        - root.absolute-position.x) / root.width);
                }
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) { keys.focus(); }
            }
            double-clicked => { Mono.split-moved(0.5); }
        }
    }
    if Mono.zone-view: Rectangle {
        property <length> cell: min(30px, (root.width - 24px) / max(1, Mono.zones.length));
        x: (root.width - self.width) / 2;
        // Over the status plate's line.
        y: root.height - self.height - 48px;
        width: Mono.zones.length * self.cell + 2px;
        height: 26px;
        border-width: 1px;
        border-color: Theme.border-strong;
        background: Theme.base;
        accessible-role: groupbox;
        accessible-label: "Zones";
        for zone[i] in Mono.zones: Rectangle {
            x: 1px + i * parent.cell;
            y: 1px;
            width: parent.cell;
            height: 24px;
            background: zone.grey;
            Text {
                width: 100%;
                height: 100%;
                text: zone.numeral;
                color: zone.dark ? #ffffff : #000000;
                font-size: Theme.font-xs;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
